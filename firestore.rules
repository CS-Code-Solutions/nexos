rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // 1. Verificação de Super Admin (Custo: 0 leituras)
    function isSuperAdmin() {
      return request.auth != null && request.auth.token.email == 'cristianst3@gmail.com';
    }

    // 2. Busca segura do Tenant pelo e-mail autenticado (Custo: 1 leitura)
    function getTenantId() {
      let userDoc = /databases/$(database)/documents/saas_users/$(request.auth.token.email);
      return exists(userDoc) ? get(userDoc).data.tenant_id : null;
    }

    // 3. Controle de Acessos e Licenças (Somente Super Admin escreve)
    match /saas_users/{userEmail} {
      allow read: if request.auth != null && (isSuperAdmin() || request.auth.token.email == userEmail);
      allow write: if isSuperAdmin();
    }

    match /saas_tenants/{tenantId} {
      allow read: if request.auth != null && (isSuperAdmin() || getTenantId() == tenantId);
      allow write: if isSuperAdmin();
    }

    // 4. Registro de Aceite dos Termos de Uso (Prova Jurídica Imutável)
    match /rg_termos_aceites/{aceiteId} {
      allow read: if request.auth != null && (isSuperAdmin() || aceiteId.matches('^' + request.auth.uid + '_.*'));
      allow create: if request.auth != null && aceiteId.matches('^' + request.auth.uid + '_.*');
      allow update, delete: if isSuperAdmin();
    }

    // 5. Configurações da Empresa (Impede cliente de alterar o próprio plano/licença)
    match /rg_config/{tenantId} {
      allow read: if request.auth != null && (isSuperAdmin() || getTenantId() == tenantId);
      allow write: if request.auth != null && (
        isSuperAdmin() ||
        (
          getTenantId() == tenantId &&
          !request.resource.data.diff(resource.data).affectedKeys().hasAny(['tipoLicenca', 'dataInicioLicenca', 'role'])
        )
      );
    }

    // 6. Regra Mestra para Coleções Operacionais (rg_reports, rg_clients, rg_machines, etc.)
    match /{collectionName}/{docId} {
      allow read, write: if request.auth != null &&
        collectionName != 'saas_users' &&
        collectionName != 'saas_tenants' &&
        collectionName != 'rg_termos_aceites' &&
        collectionName != 'rg_config' && (
          isSuperAdmin() ||
          request.auth.uid == docId ||
          getTenantId() == docId
        );
    }
  }
}
